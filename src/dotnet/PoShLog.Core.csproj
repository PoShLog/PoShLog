<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR 0001: PowerShell 7.4 hosts .NET 8; newer targets would exclude it. -->
    <TargetFramework>net8.0</TargetFramework>
    <Version>3.0.0</Version>
    <AssemblyName>PoShLog.Core</AssemblyName>
    <RootNamespace>PoShLog.Core</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Ensure Serilog dependency dlls are copied alongside the module dll so Import-Module can
         resolve them without needing a full `dotnet publish`. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Binary PowerShell module: cmdlets are implemented directly in this assembly. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only reference to System.Management.Automation. The runtime assembly is
         supplied by the hosting PowerShell (7+) process, so we exclude runtime assets to avoid
         shipping/conflicting with the host's own copy. -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.6">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0021: the extension catalogue is the manifests of the same commit, read by Get-PoShLogExtension. -->
    <EmbeddedResource Include="../../extensions/*/*.psd1" LogicalName="PoShLog.Catalog.Extensions.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../PoShLog.psd1" LogicalName="PoShLog.Catalog.PoShLog.psd1" />
  </ItemGroup>

</Project>
