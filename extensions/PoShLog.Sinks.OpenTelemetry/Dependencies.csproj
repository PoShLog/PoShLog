<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR 0001: compatible with the PowerShell 7.4 runtime. -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>PoShLog.Sinks.OpenTelemetry</AssemblyName>
    <RootNamespace>PoShLog.Sinks.OpenTelemetry</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.6" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
