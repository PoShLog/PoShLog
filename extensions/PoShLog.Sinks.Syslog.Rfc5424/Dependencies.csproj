<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR 0001: compatible with the PowerShell 7.4 runtime. -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>PoShLog.Sinks.Syslog.Rfc5424</AssemblyName>
    <RootNamespace>PoShLog.Sinks.Syslog.Rfc5424</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.SyslogMessages" Version="4.1.0" />
    <!-- Only the package's formatters and framer are used; its sinks need PeriodicBatching 5, which cannot load next to
         the 2.x that PoShLog.Sinks.Seq 1.0.0 ships. It is therefore not shipped (ADR 0014). -->
    <PackageReference Include="Serilog.Sinks.PeriodicBatching" Version="5.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.6" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
