---
// Starlight's footer plus the PoShLog build version (ADR 0022): the module version, and the commit on a build that is
// not from a release tag.
import Default from '@astrojs/starlight/components/Footer.astro';
import buildInfo from '../generated/build-info.json';
---

<Default />
<p class="build-version">
	PoShLog <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}changelog/`}>{buildInfo.display}</a>{' · '}
	<a href="https://github.com/PoShLog/PoShLog/blob/master/LICENSE">MIT license</a>
</p>

<style>
	.build-version {
		margin-top: 2rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	.build-version a {
		color: inherit;
	}
</style>
